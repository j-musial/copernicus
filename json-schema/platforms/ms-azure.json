{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://j-musial.github.io/copernicus/v0.1.0/platforms/ms-azure.json",
 "title": "Microsoft Azure",
 "type": "object",
 "if": {
  "properties": {
   "type": {
    "const": "ms-azure"
   }
  }
 },
 "then": {
  "properties": {
   "platform": {
    "const": "https://{account}.blob.core.windows.net"
   },
   "account": {
    "type": "string"
   }
  }
 }
}