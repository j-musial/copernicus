{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://j-musial.github.io/copernicus/v0.1.0/platforms/custom-s3.json",
 "title": "Generic S3",
 "type": "object",
 "if": {
  "properties": {
   "type": {
    "const": "custom-s3"
   }
  }
 },
 "then": {
